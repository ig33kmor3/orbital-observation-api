{
  "name": "orbital-observation-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write src test scripts drizzle.config.ts",
    "format:check": "prettier --check src test scripts drizzle.config.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "demo:reproduce": "tsx scripts/reproduce-incident.ts",
    "db:start": "docker compose -f compose.yaml -p orbital-observation-demo up -d --wait",
    "db:delete": "docker compose -f compose.yaml -p orbital-observation-demo down --volumes",
    "db:reset": "env -u DATABASE_URL node --env-file=.env.development scripts/reset-database.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.development ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:integration": "tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
